# PaySentinel AI — backend configuration
#
# These are read from the process environment (export them in your shell,
# or set them in the deploy platform's env config). Nothing here is
# required — the system runs fully without any of it, and the explainer
# falls back to a deterministic template.
#
#   export $(grep -v '^#' .env.example | xargs)   # quick local load

# --- AI explainability layer ---------------------------------------------
# Turn the LLM-generated explanation on (1) or off (0, default).
PAYSENTINEL_USE_LLM=0

# Model used when the LLM path is enabled.
PAYSENTINEL_LLM_MODEL=claude-opus-5

# Anthropic API key. Read automatically by the SDK; only needed when
# PAYSENTINEL_USE_LLM=1. An `ant auth login` profile works too.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Razorpay (real-mode testing) -------------------------------------------
# Test-mode keys from the Razorpay dashboard (Settings -> API Keys). Only
# needed to drive the checkout page at /checkout.html. Webhook ingestion
# (/webhooks/razorpay) does not need these.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
#
# Shared secret you set when adding the webhook in the Razorpay dashboard.
# When set, incoming webhooks must carry a valid X-Razorpay-Signature.
# PAYSENTINEL_RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxx
