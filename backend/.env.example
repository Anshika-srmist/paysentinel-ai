# PaySentinel backend — local environment.
# Copy to `.env` (gitignored) and fill in as needed. Every var here is
# optional; the app runs with none of them set.

# --- Database ---
# Unset  -> SQLite file (./paysentinel.db). Fine for local dev and tests.
# Set    -> any SQLAlchemy URL. Every deployed environment uses Postgres.
#           `postgres://` and `postgresql://` are accepted and rewritten to
#           the psycopg 3 driver automatically.
# Local Postgres example:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paysentinel
# Neon (production): copy the pooled connection string from the Neon dashboard.
#   DATABASE_URL=postgresql://<user>:<pass>@<host>.neon.tech/<db>?sslmode=require
# DATABASE_URL=

# --- Seeding ---
# On an empty database the app inserts demo traffic so the dashboard isn't
# blank. Set to 0 once you have real/seeded data you want to keep.
# PAYSENTINEL_SEED_ON_START=1
# PAYSENTINEL_SEED_COUNT=140

# --- Optional: LLM explanation polish (falls back to structured text if unset) ---
# PAYSENTINEL_USE_LLM=0
# ANTHROPIC_API_KEY=

# --- Optional: CORS allowlist (default: open) ---
# PAYSENTINEL_CORS_ORIGINS=https://your-frontend.vercel.app

# --- Optional: shared-secret gate on the integration endpoints ---
# PAYSENTINEL_API_KEY=

# --- Optional: Razorpay test-mode keys (only for the checkout demo page) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
