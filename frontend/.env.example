# Frontend configuration (Vite reads VITE_-prefixed vars at build time).
#
# Local dev: leave this unset. Requests go to /api/* and vite.config.js
# proxies them to http://localhost:8000.
#
# Production (Vercel): set this to the deployed backend origin, no trailing slash.
# VITE_API_BASE_URL=https://paysentinel-api.onrender.com
